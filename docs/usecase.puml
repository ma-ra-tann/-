@startuml 投資家リスト作成ツール ユースケース図

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam defaultFontName "Noto Sans CJK JP"
skinparam shadowing false

left to right direction

actor "ファウンダー" as founder

rectangle "投資家リスト作成ツール" {
  usecase "VCをWeb検索する" as UC1
  usecase "VC会社情報と\nキャピタリスト情報を\n取得する" as UC2
  usecase "キャピタリストごとに\n財務モデル関連性を\n分析する" as UC3
  usecase "財務モデルへの\n興味・知見レベルを\n3段階に分類する\n（⚪/△/✖）" as UC4
  usecase "コンタクト時の\n会話起点を推測する" as UC5
}

founder --> UC1

UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>


@enduml
